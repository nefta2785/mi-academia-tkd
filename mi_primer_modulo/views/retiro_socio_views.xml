<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_taekwondo_retiro_socio_list" model="ir.ui.view">
        <field name="name">taekwondo.retiro_socio.list</field>
        <field name="model">taekwondo.retiro_socio</field>
        <field name="arch" type="xml">
            <list string="Retiros de Socios">
                <field name="quien"/>
                <field name="fecha"/>
                <field name="monto"/>
                <field name="metodo_pago"/>
                <field name="nota"/>
            </list>
        </field>
    </record>

    <record id="view_taekwondo_retiro_socio_form" model="ir.ui.view">
        <field name="name">taekwondo.retiro_socio.form</field>
        <field name="model">taekwondo.retiro_socio</field>
        <field name="arch" type="xml">
            <form string="Retiro de Socio">
                <sheet>
                    <group>
                        <field name="quien"/>
                        <field name="fecha"/>
                        <field name="monto"/>
                        <field name="metodo_pago"/>
                        <field name="nota"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_taekwondo_retiro_socio" model="ir.actions.act_window">
        <field name="name">Retiros de Socios</field>
        <field name="res_model">taekwondo.retiro_socio</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_taekwondo_retiro_socio"
        name="Retiros de Socios"
        parent="mi_primer_modulo.menu_mi_academia_root"
        action="action_taekwondo_retiro_socio"
        groups="mi_primer_modulo.group_academia_admin"/>

</odoo>
