<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mi_primer_modulo.TableroCalificacion">
        <div class="p-3" style="height: 100%; overflow-y: auto;">
            <div t-if="state.cargando">Cargando información del evento...</div>
            <!-- Fila Roster + mesa: llena el alto de la raíz (height:100%) y estira
                 ambas columnas; cada una maneja su propio scroll, así la vista de
                 mesa no necesita scroll de página. -->
            <div t-else="" class="d-flex" style="align-items: stretch; gap: 1rem; height: 100%;">

                <div t-if="state.rosterColapsado" class="flex-shrink-0">
                    <button type="button" class="btn btn-sm btn-light border"
                        t-on-click="() => this.alternarRoster()" title="Mostrar roster">
                        <i class="fa fa-angle-double-right"/>
                    </button>
                </div>

                <div t-else="" style="width: 320px; flex-shrink: 0; max-height: 100%; overflow-y: auto;" class="border-end pe-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">Roster</h4>
                        <button type="button" class="btn btn-sm btn-light border"
                            t-on-click="() => this.alternarRoster()" title="Ocultar roster">
                            <i class="fa fa-angle-double-left"/>
                        </button>
                    </div>
                    <div t-if="!state.roster.length" class="text-muted">
                        Este evento todavía no tiene exámenes. Agrégalos desde el
                        formulario del evento.
                    </div>
                    <div t-else="">
                        <div class="btn-group btn-group-sm mb-3" role="group">
                            <button type="button"
                                t-att-class="'btn ' + (state.ordenPor === 'edad' ? 'btn-primary' : 'btn-outline-secondary')"
                                t-on-click="() => this.ordenarPor('edad')">Edad</button>
                            <button type="button"
                                t-att-class="'btn ' + (state.ordenPor === 'cinta' ? 'btn-primary' : 'btn-outline-secondary')"
                                t-on-click="() => this.ordenarPor('cinta')">Cinta</button>
                        </div>

                        <div t-foreach="rosterOrdenado" t-as="item" t-key="item.examenId"
                            class="d-flex align-items-center mb-2 p-2 rounded border border-transparent">
                            <img t-if="item.foto"
                                t-att-src="'data:image/png;base64,' + item.foto"
                                class="rounded-circle me-2"
                                style="width: 40px; height: 40px; object-fit: cover;"/>
                            <div t-else=""
                                class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2 border"
                                style="width: 40px; height: 40px; flex-shrink: 0;">
                                <i class="fa fa-user text-muted"/>
                            </div>
                            <div class="flex-grow-1">
                                <div>
                                    <t t-esc="item.name"/>
                                    <span t-if="item.mejorExamen" style="color:#ffc107;">★</span>
                                </div>
                                <small class="text-muted">
                                    <t t-esc="item.edad"/> años · <t t-esc="item.cintaEvaluadaLabel"/>
                                </small>
                            </div>
                            <div class="text-end ms-2 d-flex flex-column align-items-end">
                                <span t-att-class="'badge ' + (item.resultado === 'aprobado' ? 'text-bg-success' : item.resultado === 'reprobado' ? 'text-bg-danger' : 'text-bg-secondary')"
                                    t-esc="etiquetaResultado(item.resultado)"/>
                                <small class="text-muted"
                                    t-esc="(state.progreso[item.examenId] || 0) + '/4'"/>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary ms-2"
                                t-att-disabled="state.mesa.includes(item.examenId) || mesaLlena"
                                t-on-click="() => this.agregarAMesa(item.examenId)">+</button>
                        </div>
                    </div>
                </div>

                <div class="flex-grow-1 d-flex flex-column" style="min-width: 0; min-height: 0;" t-ref="columnaMesa">
                    <div class="d-flex align-items-center mb-2" style="gap: 0.75rem;">
                        <h4 class="mb-0">Mesa de calificación</h4>
                        <button t-if="state.mesa.length" type="button" class="btn btn-sm btn-outline-secondary"
                            t-on-click="() => this.acomodar()"
                            title="Borrar posiciones y acomodar en filas centradas">Acomodar</button>
                    </div>

                    <div t-if="!state.mesa.length" class="text-muted">
                        Agrega alumnos del roster con el botón + para empezar a calificar.
                    </div>

                    <t t-elif="state.expandido === null">
                    <!-- Marco: toma todo el alto que deja el dock (flex 1 1 0). -->
                    <div class="border rounded position-relative" t-ref="marco"
                        style="flex: 1 1 0; min-height: 0; overflow: auto;">

                        <div class="d-flex justify-content-end align-items-center border-bottom bg-light"
                            style="position: sticky; top: 0; z-index: 40; gap: 6px; padding: 4px 8px;"
                            t-ref="barraZoom">
                            <button type="button" class="btn btn-sm btn-light border"
                                t-on-click="() => this.zoomOut()" title="Alejar">−</button>
                            <small class="text-muted" style="min-width: 3.5em; text-align: center;"
                                t-esc="Math.round(state.zoom * 100) + '%'"/>
                            <button type="button" class="btn btn-sm btn-light border"
                                t-on-click="() => this.zoomIn()" title="Acercar">+</button>
                        </div>

                        <div t-att-style="estiloLienzo" t-ref="lienzo">

                            <div t-foreach="state.mesa" t-as="examenId" t-key="examenId"
                                t-att-data-examen-id="examenId"
                                t-att-style="estiloTarjeta(examenId)">

                                <t t-set="item" t-value="rosterPorExamenId[examenId] || {}"/>

                                <!-- Borde de color = resultado. Si su panel está abierto en el
                                     dock, estiloCabecera resalta la cabecera (anillo + tinte). -->
                                <div t-att-class="'rounded bg-white shadow-sm border border-2 ' +
                                        (item.resultado === 'aprobado' ? 'border-success' :
                                         item.resultado === 'reprobado' ? 'border-danger' :
                                         'border-secondary')"
                                    t-att-style="estiloCardBox(examenId)">

                                    <!-- Tarjeta compacta: alto fijo (ALTO_TARJETA, impuesto por
                                         estiloCardBox), sin flex-wrap. El resultado lo indica solo
                                         el color del borde; Cerrar/Expandir/Quitar viven en la barra
                                         de su panel en el dock. -->
                                    <div t-att-class="estaAbierta(examenId) ? '' : 'bg-light'"
                                        t-att-style="estiloCabecera(examenId) + ' height: 100%; overflow: hidden;'">
                                        <div class="d-flex h-100" style="user-select: none;">
                                            <div class="d-flex align-items-center justify-content-center px-2 text-muted border-end"
                                                style="cursor: grab; touch-action: none;"
                                                t-on-pointerdown="(ev) => this.alPresionarManija(ev, examenId)"
                                                t-on-pointermove="(ev) => this.alMoverManija(ev)"
                                                t-on-pointerup="(ev) => this.alSoltarManija(ev)"
                                                t-on-pointercancel="(ev) => this.alSoltarManija(ev)"
                                                title="Arrastrar para reposicionar">
                                                <i class="fa fa-arrows"/>
                                            </div>

                                            <div class="flex-grow-1 d-flex align-items-center px-2 position-relative"
                                                style="cursor: pointer; min-width: 0; gap: 0.5rem;"
                                                t-on-click="() => this.alternarTarjeta(examenId)">
                                                <img t-if="item.foto"
                                                    t-att-src="'data:image/png;base64,' + item.foto"
                                                    class="rounded-circle"
                                                    style="width: 36px; height: 36px; object-fit: cover; flex-shrink: 0;"/>
                                                <div t-else=""
                                                    class="rounded-circle bg-white d-flex align-items-center justify-content-center border"
                                                    style="width: 36px; height: 36px; flex-shrink: 0;">
                                                    <i class="fa fa-user text-muted"/>
                                                </div>
                                                <!-- padding-right: deja libre la columna de las esquinas
                                                     (★ y x/4) para que el texto trunque antes de pisarlas. -->
                                                <div class="flex-grow-1" style="min-width: 0; padding-right: 1.5rem;">
                                                    <strong class="d-block text-truncate"
                                                        t-esc="item.name || ('Examen ' + examenId)"/>
                                                    <small class="d-block text-truncate text-muted"
                                                        t-esc="item.cintaEvaluadaLabel"/>
                                                </div>
                                                <span t-if="item.mejorExamen"
                                                    class="position-absolute"
                                                    style="top: 2px; right: 4px; color: #ffc107; font-size: 0.75rem; line-height: 1;">★</span>
                                                <small class="position-absolute text-muted"
                                                    style="bottom: 2px; right: 4px; font-size: 0.7rem; line-height: 1;"
                                                    t-esc="(state.progreso[examenId] || 0) + '/4'"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Divisor marco/dock: arrastrarlo cambia state.altoDock. -->
                    <div t-if="state.tarjetasAbiertas.length"
                        class="d-flex align-items-center justify-content-center"
                        t-att-style="estiloDivisor"
                        t-on-pointerdown="(ev) => this.alPresionarDivisor(ev)"
                        t-on-pointermove="(ev) => this.alMoverDivisor(ev)"
                        t-on-pointerup="(ev) => this.alSoltarDivisor(ev)"
                        t-on-pointercancel="(ev) => this.alSoltarDivisor(ev)"
                        title="Arrastrar para cambiar el alto del panel">
                        <div class="rounded bg-secondary" style="width: 48px; height: 4px; opacity: 0.5; pointer-events: none;"/>
                    </div>

                    <!-- Dock: un panel por tarjeta abierta, en el orden de
                         tarjetasAbiertas, lado a lado y sin traslapes. Alto fijo en px
                         (estiloDock); scroll horizontal propio y cada panel con su
                         scroll vertical (estiloPanelDock). Vive en esta misma rama
                         t-elif, así que al expandir se desmonta junto con la mesa. -->
                    <div t-if="state.tarjetasAbiertas.length"
                        class="d-flex"
                        t-att-style="estiloDock">
                        <div t-foreach="state.tarjetasAbiertas" t-as="examenId" t-key="examenId"
                            class="bg-white border rounded"
                            t-att-style="estiloPanelDock">
                            <div class="d-flex justify-content-end p-2 bg-light border-bottom" style="gap: 0.5rem;">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                    t-on-click="() => this.alternarTarjeta(examenId)">Cerrar</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                    t-on-click="() => this.expandir(examenId)">Expandir</button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                    t-on-click="() => this.quitarDeMesa(examenId)">Quitar de la mesa</button>
                            </div>
                            <PanelCalificacion t-key="examenId"
                                examenId="examenId"
                                onGuardado="(id) => this.onCriterioGuardado(id)"
                                onResultadoCambiado="(id, valor) => this.onResultadoCambiado(id, valor)"
                                onMejorExamenCambiado="(id, valor) => this.onMejorExamenCambiado(id, valor)"/>
                        </div>
                    </div>
                    </t>

                    <!-- Vista expandida: la columna ahora tiene alto fijo, así que
                         esta vista hace scroll dentro de sí misma. -->
                    <div t-else="" style="flex: 1 1 0; min-height: 0; overflow-y: auto;">
                        <button type="button" class="btn btn-secondary mb-3"
                            t-on-click="() => this.regresar()">← Regresar a la mesa</button>
                        <div class="border rounded">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-light border-bottom">
                                <strong t-esc="(rosterPorExamenId[state.expandido] || {}).name || ('Examen ' + state.expandido)"/>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                    t-on-click="() => this.quitarDeMesa(state.expandido)">Quitar de la mesa</button>
                            </div>
                            <PanelCalificacion t-key="state.expandido"
                                examenId="state.expandido"
                                onGuardado="(id) => this.onCriterioGuardado(id)"
                                onResultadoCambiado="(id, valor) => this.onResultadoCambiado(id, valor)"
                                onMejorExamenCambiado="(id, valor) => this.onMejorExamenCambiado(id, valor)"/>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
